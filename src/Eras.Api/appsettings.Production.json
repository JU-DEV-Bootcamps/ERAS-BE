{
  "EnableSwagger": "__ENABLE_SWAGGER__",
  "CosmicLatte": {
    "BaseUrl": "__COSMIC_API_URL__",
    "ApiKey": "__COSMIC_LATTE_API_KEY__"
  },
  "Encryption": {
    "Key": "__ENCRYPTION_KEY__",
    "IV": "__ENCRYPTION_IV__"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileStorage": {
    "BasePath": "/app/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [".pdf", ".jpg", ".jpeg", ".png", ".docx", ".txt"],
    "DefaultMaxAttachmentsPerEntity": 5,
    "MaxAttachmentsPerEntityType": {
      "interventions": 5
    },
    "TempAttachmentTtlHours": 24,
    "TempAttachmentCleanupIntervalHours": 1
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "BaseUrl": "__KEYCLOAK_URL__",
    "Realm": "__KEYCLOAK_REALM__",
    "ClientId": "__CLIENT_ID__",
    "ClientSecret": "__KEYCLOAK_CLIENT_SECRET__",
    "Audience": "__KEYCLOAK_CLIENT_AUDIENCE__",
    "RolesResource": "__KEYCLOAK_ROLES_RESOURCE__",
    "RoleNames": {
      "Administrator": "__KEYCLOAK_ROLE_ADMINISTRATOR__",
      "Officer": "__KEYCLOAK_ROLE_OFFICER__",
      "Professional": "__KEYCLOAK_ROLE_PROFESSIONAL__"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:443",
        "Certificate": {
          "Path": "/https/aspnetapp.pfx",
          "Password": "eras"
        }
      }
    }
  }
}
